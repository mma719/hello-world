# Auto-detect text files and normalize line endings
* text=auto

# Explicit rules for common text formats
*.txt text eol=lf
*.md  text eol=lf

# C/C++ source headers
*.cpp text eol=lf
*.h   text eol=lf

# Git config files (treat as text and normalize)
.gitattributes text eol=lf
.gitignore     text eol=lf
.gitmodules    text eol=lf
.gitconfig     text eol=lf
